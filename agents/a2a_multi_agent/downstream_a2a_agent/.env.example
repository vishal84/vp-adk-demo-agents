# Downstream BigQuery Agent - A2A Server
# Environment variables (copy to .env)

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# BigQuery dataset and table to query
BIGQUERY_DATASET=your_dataset
BIGQUERY_TABLE=your_table

# Optional: Location for Agent Engine deployment
GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# Agent Card Configuration (A2A)
# =============================================================================
# These settings customize the agent card served at /.well-known/agent.json

# Agent identification
AGENT_NAME=bigquery_agent
AGENT_DESCRIPTION=An agent that can query BigQuery datasets using SQL. It can list tables, get table schemas, and execute SQL queries.
AGENT_VERSION=1.0.0

# Agent URL (where this agent is hosted)
AGENT_URL=http://localhost:8001

# Provider information (optional)
AGENT_PROVIDER_NAME=Demo
AGENT_PROVIDER_URL=http://example.com
