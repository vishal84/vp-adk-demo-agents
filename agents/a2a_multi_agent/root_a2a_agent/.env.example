# Root A2A Agent - A2A Client/Orchestrator
# Environment variables (copy to .env)

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Downstream agent A2A endpoint URL
# For local testing: http://localhost:8001
# For Agent Engine: https://<region>-aiplatform.googleapis.com/...
DOWNSTREAM_AGENT_URL=http://localhost:8001

# OAuth 2.0 Client credentials (for user authentication)
CLIENT_ID=your-oauth-client-id
CLIENT_SECRET=your-oauth-client-secret

# Optional: Location for Agent Engine deployment
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Service account for Cloud Run auth (if downstream is on Cloud Run)
SERVICE_ACCOUNT_EMAIL=
